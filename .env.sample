# ─────────────────────────────────────────────────────────────────────────────
# DocSplitter environment variables
# Copy this file to .env and fill in your values.
# docker compose automatically loads .env from the project root.
# ─────────────────────────────────────────────────────────────────────────────

# ── AI Backend ───────────────────────────────────────────────────────────────
# Choose one of the provider blocks below.

# -- Option A: OpenAI --
# DOCSPLITTER_AI__API_KEY=sk-your-key-here
# DOCSPLITTER_AI__BASE_URL=https://api.openai.com/v1
# DOCSPLITTER_AI__MODEL=gpt-4o

# -- Option B: Azure OpenAI (Cognitive Services endpoint) --
# DOCSPLITTER_AI__API_KEY=your-azure-api-key
# DOCSPLITTER_AI__BASE_URL=https://your-resource.cognitiveservices.azure.com
# DOCSPLITTER_AI__API_VERSION=2025-01-01-preview
# DOCSPLITTER_AI__MODEL=gpt-4o

# -- Option C: Local LLM via LM Studio / Ollama (OpenAI-compatible) --
# Use host.docker.internal to reach a model running on the Docker host machine.
# DOCSPLITTER_AI__API_KEY=no-key
# DOCSPLITTER_AI__BASE_URL=http://host.docker.internal:1234/v1
# DOCSPLITTER_AI__MODEL=qwen/qwen3-vl-8b

# ── AI Tuning (optional) ─────────────────────────────────────────────────────

# Resolution to render PDF pages before sending to the model (dots per inch).
# Higher = more accurate but larger payloads and slower. 150 is a good default.
# DOCSPLITTER_AI__RENDER_DPI=150

# Image format sent to the model: jpeg (smaller) or png (higher fidelity)
# DOCSPLITTER_AI__IMAGE_FORMAT=jpeg

# JPEG quality 0–100 (only used when IMAGE_FORMAT=jpeg)
# DOCSPLITTER_AI__IMAGE_QUALITY=85

# Image detail level passed to the model vision API.
# auto  — model decides tile resolution (best accuracy, higher cost for GPT-4o)
# low   — fixed 512×512 preview (faster, cheaper, may miss fine text)
# high  — always high-res tiles
# DOCSPLITTER_AI__IMAGE_DETAIL=auto

# Max tokens per model response (analysis replies are short; 600 is plenty)
# DOCSPLITTER_AI__MAX_TOKENS=600

# Per-call timeout in seconds
# DOCSPLITTER_AI__TIMEOUT_SECONDS=60

# Number of retries on transient API errors
# DOCSPLITTER_AI__MAX_RETRIES=3

# ── Server ───────────────────────────────────────────────────────────────────

# Host port to expose the API on (container always listens on 8000 internally)
PORT=8000

# ── Output ───────────────────────────────────────────────────────────────────

# Whether to write a JSON metadata sidecar alongside each split PDF
# DOCSPLITTER_OUTPUT__WRITE_METADATA_JSON=true

# Output filename template.
# Variables: {channel} {date} {doc_type} {doc_index} {job_id}
# DOCSPLITTER_OUTPUT__FILENAME_TEMPLATE={date}_{doc_type}_{doc_index:03d}.pdf
